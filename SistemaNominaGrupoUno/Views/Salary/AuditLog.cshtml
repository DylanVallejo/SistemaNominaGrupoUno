@model List<SistemaNominaGrupoUno.Context.LogAuditoriaSalarios>

@{
    ViewData["Title"] = "Log de Auditoría Salarial";
    var search      = ViewBag.Search      as string ?? "";
    var currentPage = (int)(ViewBag.CurrentPage ?? 1);
    var totalPages  = (int)(ViewBag.TotalPages  ?? 1);
    var totalItems  = (int)(ViewBag.TotalItems  ?? 0);
}

<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2 class="mb-0">
        <i class="bi bi-journal-text me-2 text-secondary"></i>Log de Auditoría Salarial
    </h2>
</div>

@* ── Barra de búsqueda (RF-10) ── *@
<form method="get" asp-action="AuditLog" class="mb-3">
    <div class="row g-2">
        <div class="col-md-8">
            <div class="input-group">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" value="@search"
                       class="form-control"
                       placeholder="Buscar por empleado, usuario o detalle del cambio..." />
            </div>
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel-fill me-1"></i> Filtrar
            </button>
            <a asp-action="AuditLog" class="btn btn-outline-secondary w-100">
                <i class="bi bi-x-circle me-1"></i> Limpiar
            </a>
        </div>
    </div>
</form>

@* ── Resultado ── *@
<p class="text-muted small">
    Mostrando <strong>@Model.Count</strong> de <strong>@totalItems</strong> registros
    @if (!string.IsNullOrWhiteSpace(search)) { <span>para "<em>@search</em>"</span> }
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-1"></i> No se encontraron registros con los filtros aplicados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle shadow-sm rounded">
            <thead class="table-dark">
                <tr>
                    <th class="text-center">#</th>
                    <th>Empleado</th>
                    <th class="text-end">Salario</th>
                    <th>Detalle del Cambio</th>
                    <th class="text-center">Usuario</th>
                    <th class="text-center">Fecha / Hora</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td class="text-center text-muted small">@log.Id</td>
                        <td>
                            <span class="badge bg-secondary me-1">#@log.EmpNo</span>
                            <strong>@log.Employee.LastName</strong>, @log.Employee.FirstName
                        </td>
                        <td class="text-end fw-bold text-success">
                            <i class="bi bi-currency-dollar text-muted"></i>@log.Salario.ToString("N0")
                        </td>
                        <td class="small">@log.DetalleCambio</td>
                        <td class="text-center">
                            <span class="badge bg-secondary">
                                <i class="bi bi-person me-1"></i>@log.Usuario
                            </span>
                        </td>
                        <td class="text-center small text-muted">
                            <i class="bi bi-clock me-1"></i>
                            @log.FechaActualizacion.ToString("yyyy-MM-dd HH:mm:ss")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* ── Paginación (RNF-01) ── *@
    @if (totalPages > 1)
    {
        <nav aria-label="Paginación de auditoría">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="AuditLog"
                       asp-route-page="@(currentPage - 1)"
                       asp-route-search="@search">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="AuditLog"
                           asp-route-page="@p"
                           asp-route-search="@search">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="AuditLog"
                       asp-route-page="@(currentPage + 1)"
                       asp-route-search="@search">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
        <p class="text-center text-muted small">Página @currentPage de @totalPages</p>
    }
}
