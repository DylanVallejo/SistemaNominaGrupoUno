@model List<SistemaNominaGrupoUno.Context.LogAuditoriaSalarios>

@{
    ViewData["Title"] = "Cambios Salariales";
    var desde = ViewBag.Desde as string ?? "";
    var hasta = ViewBag.Hasta as string ?? "";
}

<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2 class="mb-0">
        <i class="bi bi-arrow-left-right me-2 text-warning"></i>Cambios Salariales
    </h2>
</div>

@* ── Filtros ── *@
<form method="get" asp-action="CambiosSalariales" class="mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label fw-semibold small text-uppercase">Fecha Desde</label>
            <input type="date" name="desde" value="@desde" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label fw-semibold small text-uppercase">Fecha Hasta</label>
            <input type="date" name="hasta" value="@hasta" class="form-control" />
        </div>
        <div class="col-md-3 d-flex gap-2 align-self-end">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel-fill me-1"></i> Filtrar
            </button>
            <a asp-action="CambiosSalariales" class="btn btn-outline-secondary w-100">
                <i class="bi bi-x-circle me-1"></i> Hoy
            </a>
        </div>
        <div class="col-md-3 d-flex gap-2 align-self-end">
            <a asp-action="CambiosSalarialesPdf"
               asp-route-desde="@desde" asp-route-hasta="@hasta"
               class="btn btn-danger w-100">
                <i class="bi bi-file-earmark-pdf-fill me-1"></i> PDF
            </a>
            <a asp-action="CambiosSalarialesExcel"
               asp-route-desde="@desde" asp-route-hasta="@hasta"
               class="btn btn-success w-100">
                <i class="bi bi-file-earmark-spreadsheet-fill me-1"></i> Excel
            </a>
        </div>
    </div>
</form>

<p class="text-muted small">
    Período: <strong>@desde</strong> al <strong>@hasta</strong> —
    <strong>@Model.Count</strong> registro(s)
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-1"></i>
        No se registraron cambios salariales en el período indicado.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle shadow-sm rounded">
            <thead class="table-dark">
                <tr>
                    <th class="text-center">#</th>
                    <th>Empleado</th>
                    <th class="text-end">Salario</th>
                    <th class="text-center">Usuario</th>
                    <th>Detalle del Cambio</th>
                    <th class="text-center">Fecha / Hora</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td class="text-center text-muted small">@log.Id</td>
                        <td>
                            <span class="badge bg-secondary me-1">#@log.EmpNo</span>
                            <strong>@log.Employee.LastName</strong>, @log.Employee.FirstName
                        </td>
                        <td class="text-end fw-bold text-success">
                            <i class="bi bi-currency-dollar text-muted"></i>@log.Salario.ToString("N0")
                        </td>
                        <td class="text-center">
                            <span class="badge bg-secondary">
                                <i class="bi bi-person me-1"></i>@log.Usuario
                            </span>
                        </td>
                        <td class="small">@log.DetalleCambio</td>
                        <td class="text-center small text-muted">
                            <i class="bi bi-clock me-1"></i>
                            @log.FechaActualizacion.ToString("dd/MM/yyyy HH:mm")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
