@model SistemaNominaGrupoUno.Context.DTOS.DeptManagerViewModel

@{
    ViewData["Title"] = "Asignar Gerente";
}

<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2 class="mb-0">
        <i class="bi bi-person-badge-fill me-2 text-success"></i>Asignar Gerente de Departamento
    </h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="bi bi-person-badge me-2"></i>Datos de la Gerencia
                </h5>
            </div>
            <div class="card-body">

                @* Alerta informativa sobre la regla de exclusividad *@
                <div class="alert alert-info py-2 small">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    <strong>Regla:</strong> Un departamento solo puede tener un gerente activo
                    por período. Si el departamento ya tiene gerente vigente, termine su
                    vigencia antes de asignar uno nuevo.
                </div>

                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    @* Errores globales *@
                    @if (!ViewData.ModelState.IsValid &&
                         ViewData.ModelState.ContainsKey(string.Empty))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            @Html.ValidationMessage(string.Empty)
                        </div>
                    }

                    <div class="row g-3">
                        @* Departamento *@
                        <div class="col-12">
                            <label asp-for="DeptNo" class="form-label fw-semibold"></label>
                            <select asp-for="DeptNo" asp-items="ViewBag.Departments"
                                    class="form-select">
                                <option value="">-- Seleccione un departamento --</option>
                            </select>
                            <span asp-validation-for="DeptNo" class="text-danger small"></span>
                        </div>

                        @* Gerente (Empleado) *@
                        <div class="col-12">
                            <label asp-for="EmpNo" class="form-label fw-semibold"></label>
                            <select asp-for="EmpNo" asp-items="ViewBag.Employees"
                                    class="form-select">
                                <option value="">-- Seleccione el empleado gerente --</option>
                            </select>
                            <span asp-validation-for="EmpNo" class="text-danger small"></span>
                        </div>

                        @* Fecha Desde *@
                        <div class="col-md-6">
                            <label asp-for="FromDate" class="form-label fw-semibold"></label>
                            <input asp-for="FromDate" type="date" class="form-control" />
                            <span asp-validation-for="FromDate" class="text-danger small"></span>
                        </div>

                        @* Fecha Hasta *@
                        <div class="col-md-6">
                            <label asp-for="ToDate" class="form-label fw-semibold"></label>
                            <input asp-for="ToDate" type="date" class="form-control" />
                            <span asp-validation-for="ToDate" class="text-danger small"></span>
                            <div class="form-text">Dejar vacío si el cargo no tiene fecha de fin.</div>
                        </div>
                    </div>

                    <hr class="mt-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-floppy me-1"></i> Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
