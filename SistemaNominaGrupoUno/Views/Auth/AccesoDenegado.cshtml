@{
    ViewData["Title"] = "Acceso denegado";
    Layout = "_Layout";
}

<!-- RF-01: Página de acceso denegado por rol insuficiente -->
<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-danger">
            <div class="card-body py-5">
                <i class="bi bi-shield-x text-danger" style="font-size: 4rem;"></i>
                <h2 class="mt-3 text-danger">Acceso denegado</h2>
                <p class="text-muted mt-2">
                    No tiene permisos suficientes para acceder a esta sección.<br />
                    Comuníquese con el administrador del sistema si cree que esto es un error.
                </p>
                <div class="mt-4 d-flex gap-2 justify-content-center">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                        <i class="bi bi-house-fill me-1"></i>Ir al inicio
                    </a>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-secondary">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar sesión con otra cuenta
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
