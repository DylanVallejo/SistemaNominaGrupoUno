@model SistemaNominaGrupoUno.Context.DTOS.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_Layout";
}

<!-- RF-01: Formulario de inicio de sesión con validación de credenciales -->
<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white text-center py-3">
                <i class="bi bi-person-lock fs-2 d-block mb-1"></i>
                <h4 class="mb-0">Sistema de Nómina</h4>
                <small class="opacity-75">Ingrese sus credenciales para continuar</small>
            </div>
            <div class="card-body p-4">

                @* RF-01: Mostrar error de credenciales incorrectas *@
                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger py-2" role="alert"></div>
                }

                <form asp-action="Login" asp-controller="Auth" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Usuario" class="form-label fw-semibold">
                            <i class="bi bi-person me-1"></i>Usuario
                        </label>
                        <input asp-for="Usuario"
                               class="form-control"
                               placeholder="Ingrese su usuario"
                               autocomplete="username"
                               autofocus />
                        <span asp-validation-for="Usuario" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Clave" class="form-label fw-semibold">
                            <i class="bi bi-lock me-1"></i>Contraseña
                        </label>
                        <input asp-for="Clave"
                               class="form-control"
                               placeholder="Ingrese su contraseña"
                               autocomplete="current-password" />
                        <span asp-validation-for="Clave" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Iniciar sesión
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <p class="text-center text-muted mt-3 small">
            &copy; 2026 - SistemaNominaGrupoUno &mdash; Grupo Uno
        </p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
