@model SistemaNominaGrupoUno.Context.DTOS.UserViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2 class="mb-0">
        <i class="bi bi-pencil-square me-2 text-warning"></i>Editar Usuario
    </h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Modificar Datos del Usuario</h5>
            </div>
            <div class="card-body">

                <div class="alert alert-info py-2 small">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    <strong>Nota:</strong> Para cambiar la contraseña use la opción
                    "Restablecer Contraseña" desde el listado.
                </div>

                <form asp-action="Edit" asp-route-empNo="@Model.EmpNo"
                      method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="EmpNo" type="hidden" />

                    @if (!ViewData.ModelState.IsValid &&
                         ViewData.ModelState.ContainsKey(string.Empty))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            @Html.ValidationMessage(string.Empty)
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label fw-semibold text-muted small text-uppercase">Empleado</label>
                            <input type="text" class="form-control bg-light"
                                   value="@ViewBag.EmpDisplay" readonly />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Usuario" class="form-label fw-semibold"></label>
                            <input asp-for="Usuario" type="text" class="form-control"
                                   autocomplete="off" />
                            <span asp-validation-for="Usuario" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Rol" class="form-label fw-semibold"></label>
                            <select asp-for="Rol" asp-items="ViewBag.Roles"
                                    class="form-select"></select>
                            <span asp-validation-for="Rol" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="mt-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-floppy me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
