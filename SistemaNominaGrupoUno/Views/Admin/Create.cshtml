@model SistemaNominaGrupoUno.Context.DTOS.UserViewModel

@{
    ViewData["Title"] = "Nuevo Usuario";
}

<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2 class="mb-0">
        <i class="bi bi-person-plus-fill me-2 text-dark"></i>Nuevo Usuario
    </h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0"><i class="bi bi-shield-lock me-2"></i>Datos del Usuario</h5>
            </div>
            <div class="card-body">

                <div class="alert alert-info py-2 small">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    <strong>Nota:</strong> La contraseña se almacena como hash BCrypt
                    (nunca en texto plano). El alta queda registrada en el log de actividad.
                </div>

                <form asp-action="Create" method="post" novalidate>
                    @Html.AntiForgeryToken()

                    @if (!ViewData.ModelState.IsValid &&
                         ViewData.ModelState.ContainsKey(string.Empty))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            @Html.ValidationMessage(string.Empty)
                        </div>
                    }

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="EmpNo" class="form-label fw-semibold"></label>
                            <select asp-for="EmpNo" asp-items="ViewBag.Employees"
                                    class="form-select">
                                <option value="">-- Seleccione un empleado --</option>
                            </select>
                            <span asp-validation-for="EmpNo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Usuario" class="form-label fw-semibold"></label>
                            <input asp-for="Usuario" type="text" class="form-control"
                                   placeholder="ej: jperez" autocomplete="off" />
                            <span asp-validation-for="Usuario" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Rol" class="form-label fw-semibold"></label>
                            <select asp-for="Rol" asp-items="ViewBag.Roles"
                                    class="form-select"></select>
                            <span asp-validation-for="Rol" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Clave" class="form-label fw-semibold"></label>
                            <input asp-for="Clave" type="password" class="form-control"
                                   autocomplete="new-password" />
                            <span asp-validation-for="Clave" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ConfirmClave" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmClave" type="password" class="form-control"
                                   autocomplete="new-password" />
                            <span asp-validation-for="ConfirmClave" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="mt-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-dark">
                            <i class="bi bi-floppy me-1"></i> Guardar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
