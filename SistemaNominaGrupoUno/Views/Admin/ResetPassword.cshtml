@model SistemaNominaGrupoUno.Context.DTOS.UserViewModel

@{
    ViewData["Title"] = "Restablecer Contraseña";
}

<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2 class="mb-0">
        <i class="bi bi-key-fill me-2 text-danger"></i>Restablecer Contraseña
    </h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">
                    <i class="bi bi-shield-lock me-2"></i>Nueva Contraseña para: <code>@ViewBag.Usuario</code>
                </h5>
            </div>
            <div class="card-body">

                <div class="alert alert-warning py-2 small">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                    <strong>Atención:</strong> La nueva contraseña reemplazará la actual.
                    Se almacenará como hash BCrypt. Mínimo 6 caracteres.
                </div>

                <form asp-action="ResetPassword" asp-route-empNo="@Model.EmpNo"
                      method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="EmpNo"    type="hidden" />
                    <input asp-for="Usuario"  type="hidden" />
                    <input asp-for="Rol"      type="hidden" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold text-muted small text-uppercase">Empleado</label>
                        <input type="text" class="form-control bg-light"
                               value="@ViewBag.EmpDisplay" readonly />
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Clave" class="form-label fw-semibold"></label>
                            <input asp-for="Clave" type="password" class="form-control"
                                   autocomplete="new-password" placeholder="Mínimo 6 caracteres" />
                            <span asp-validation-for="Clave" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ConfirmClave" class="form-label fw-semibold"></label>
                            <input asp-for="ConfirmClave" type="password" class="form-control"
                                   autocomplete="new-password" />
                            <span asp-validation-for="ConfirmClave" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="mt-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-key me-1"></i> Restablecer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
