@model SistemaNominaGrupoUno.Context.DTOS.DeptEmpViewModel

@{
    ViewData["Title"] = "Editar Asignación";
}

<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2 class="mb-0">
        <i class="bi bi-pencil-square me-2 text-warning"></i>Editar Asignación
    </h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-diagram-3 me-2"></i>Modificar Vigencia
                </h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-empNo="@Model.EmpNo"
                      asp-route-deptNo="@Model.DeptNo" method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="EmpNo"  type="hidden" />
                    <input asp-for="DeptNo" type="hidden" />

                    @* Errores globales de solapamiento *@
                    @if (!ViewData.ModelState.IsValid &&
                         ViewData.ModelState.ContainsKey(string.Empty))
                    {
                        <div class="alert alert-danger">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            @Html.ValidationMessage(string.Empty)
                        </div>
                    }

                    <div class="row g-3 mb-3">
                        @* Empleado (solo lectura) *@
                        <div class="col-12">
                            <label class="form-label fw-semibold text-muted small text-uppercase">Empleado</label>
                            <input type="text" class="form-control bg-light"
                                   value="@ViewBag.EmpDisplay" readonly />
                        </div>

                        @* Departamento (solo lectura) *@
                        <div class="col-12">
                            <label class="form-label fw-semibold text-muted small text-uppercase">Departamento</label>
                            <input type="text" class="form-control bg-light"
                                   value="@ViewBag.DeptDisplay" readonly />
                        </div>

                        @* Fecha Desde *@
                        <div class="col-md-6">
                            <label asp-for="FromDate" class="form-label fw-semibold"></label>
                            <input asp-for="FromDate" type="date" class="form-control" />
                            <span asp-validation-for="FromDate" class="text-danger small"></span>
                        </div>

                        @* Fecha Hasta *@
                        <div class="col-md-6">
                            <label asp-for="ToDate" class="form-label fw-semibold"></label>
                            <input asp-for="ToDate" type="date" class="form-control" />
                            <span asp-validation-for="ToDate" class="text-danger small"></span>
                            <div class="form-text">Dejar vacío si la asignación no tiene fecha de fin.</div>
                        </div>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-floppy me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
