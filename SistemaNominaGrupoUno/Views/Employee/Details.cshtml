@model Employees

@{
    ViewData["Title"] = "Detalle Empleado";
}

<div class="d-flex align-items-center mb-3 gap-2">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2 class="mb-0"><i class="bi bi-person-badge-fill me-2 text-info"></i>Detalle del Empleado</h2>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center
                        @(Model.IsActive ? "bg-info text-white" : "bg-secondary text-white")">
                <h5 class="mb-0">
                    <i class="bi bi-person-circle me-2"></i>
                    @Model.FirstName @Model.LastName
                </h5>
                @if (Model.IsActive)
                {
                    <span class="badge bg-success fs-6">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">Inactivo</span>
                }
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold text-uppercase">N° Empleado</label>
                        <p class="mb-0 fs-5"><span class="badge bg-secondary">#@Model.EmpNo</span></p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold text-uppercase">Cédula de Identidad</label>
                        <p class="mb-0 fs-5">@Model.Ci</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold text-uppercase">Nombre</label>
                        <p class="mb-0 fs-5">@Model.FirstName</p>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted small fw-bold text-uppercase">Apellido</label>
                        <p class="mb-0 fs-5">@Model.LastName</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted small fw-bold text-uppercase">Género</label>
                        <p class="mb-0">
                            @if (Model.Gender == 'M')
                            {
                                <span class="badge bg-primary fs-6">
                                    <i class="bi bi-gender-male me-1"></i>Masculino
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">
                                    <i class="bi bi-gender-female me-1"></i>Femenino
                                </span>
                            }
                        </p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted small fw-bold text-uppercase">Fecha de Nacimiento</label>
                        <p class="mb-0 fs-5"><i class="bi bi-calendar-heart me-1 text-muted"></i>@Model.BirthDate</p>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label text-muted small fw-bold text-uppercase">Fecha de Contratación</label>
                        <p class="mb-0 fs-5"><i class="bi bi-calendar-check me-1 text-muted"></i>@Model.HireDate</p>
                    </div>
                    <div class="col-12">
                        <label class="form-label text-muted small fw-bold text-uppercase">Correo Electrónico</label>
                        <p class="mb-0 fs-5">
                            <i class="bi bi-envelope-fill me-1 text-muted"></i>
                            <a href="mailto:@Model.Correo">@Model.Correo</a>
                        </p>
                    </div>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-list-ul me-1"></i> Volver al Listado
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.EmpNo" class="btn btn-warning">
                        <i class="bi bi-pencil-square me-1"></i> Editar
                    </a>
                    @if (Model.IsActive)
                    {
                        <form asp-action="Deactivate" asp-route-id="@Model.EmpNo" method="post"
                              onsubmit="return confirm('¿Desea dar de baja al empleado @Model.FirstName @Model.LastName?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-person-x-fill me-1"></i> Dar de Baja
                            </button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate" asp-route-id="@Model.EmpNo" method="post"
                              onsubmit="return confirm('¿Desea reactivar al empleado @Model.FirstName @Model.LastName?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-person-check-fill me-1"></i> Reactivar
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
